# Optional integrations. Leave blank to use local, corpus-based features.
OPENAI_API_KEY=
GOOGLE_FACTCHECK_API_KEY=

# Browser origins allowed to call the API. Keep local origins for local use.
WAYFIND_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
WAYFIND_DATA_DIR=data

# Set these in the hosting provider's secret/environment settings for production.
WAYFIND_ENV=development
WAYFIND_ACCESS_USERNAME=
WAYFIND_ACCESS_PASSWORD=

# Optional model/index settings for the legacy hybrid indexing pipeline.
USE_LOCAL_EMBEDDINGS=true
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
USE_LOCAL_LLM=true
LOCAL_LLM_MODEL=distilgpt2
